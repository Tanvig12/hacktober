# Copy to .env.local and fill in. Never commit .env.local.

# Gemini API key from Google AI Studio. Required.
GEMINI_API_KEY=

# Primary Gemini model. Default: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Model used when the primary one fails. Default: gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Image provider: pollinations (no key needed) or cloudflare. Default: pollinations
IMAGE_PROVIDER=pollinations

# Cloudflare account ID. Required only when IMAGE_PROVIDER=cloudflare.
CF_ACCOUNT_ID=

# Cloudflare API token with Workers AI access. Required only when IMAGE_PROVIDER=cloudflare.
CF_API_TOKEN=

# Serve fixture results with zero network calls (true or false). Default: false
DEMO_MODE=false
